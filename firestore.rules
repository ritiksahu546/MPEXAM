rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'gig.ritik546@gmail.com' ||
        request.auth.token.email == 'admin@mpexamupdate.in'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/{testId} {
      allow get: if isValidId(testId);
    }

    // Posts collection: Public can read published posts. Admin can CRUD all posts.
    match /posts/{postId} {
      allow get: if isValidId(postId) && (
        resource.data.status == 'published' || isAdmin()
      );
      allow list: if resource.data.status == 'published' || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        resource.data.status == 'published' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']) &&
        request.resource.data.viewCount is number
      );
    }

    // Categories collection: Public can read. Admin can modify.
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Tags collection: Public can read. Admin can modify.
    match /tags/{tagId} {
      allow get: if isValidId(tagId);
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Ads collection: Public can read configurations. Admin can modify.
    match /ads/{adId} {
      allow get: if isValidId(adId);
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Important Links collection: Public can read official links. Admin can modify.
    match /links/{linkId} {
      allow get: if isValidId(linkId);
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Settings / SiteSettings collection: Public can read general site settings. Admin can write.
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Homepage sections collection
    match /homepageSections/{sectionId} {
      allow get: if isValidId(sectionId);
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin collection to manage authorized admins
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list, write: if isAdmin() || (isSignedIn() && request.auth.uid == adminId && isSuperAdmin());
    }
  }
}
